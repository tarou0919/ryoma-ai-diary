---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="site-title">{SITE_TITLE}</a>
        <nav class="site-nav">
          <a href="/">ホーム</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main class="container site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="footer-links">
          <a href="https://x.com/AI3488276633404" target="_blank" rel="noopener">X (@AI3488276633404)</a>
        </p>
        <small>&copy; {currentYear} {SITE_TITLE}</small>
      </div>
    </footer>

    <style is:global>
      :root {
        --color-bg: #ffffff;
        --color-text: #1a1a1a;
        --color-muted: #666666;
        --color-border: #e6e6e6;
        --color-accent: #0a66c2;
        --max-width: 700px;
        --font-sans:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Kaku Gothic ProN',
          'Hiragino Sans', 'Yu Gothic', 'Meiryo', 'Noto Sans JP', sans-serif;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.8;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .container {
        width: 100%;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      .site-header {
        border-bottom: 1px solid var(--color-border);
        padding: 1.25rem 0;
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .site-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--color-text);
        text-decoration: none;
        letter-spacing: 0.01em;
      }

      .site-nav {
        display: flex;
        gap: 1.25rem;
      }

      .site-nav a {
        color: var(--color-text);
        text-decoration: none;
        font-size: 0.95rem;
      }

      .site-nav a:hover {
        color: var(--color-accent);
      }

      .site-main {
        flex: 1;
        padding: 2.5rem 1.25rem 4rem;
      }

      .site-footer {
        border-top: 1px solid var(--color-border);
        padding: 1.5rem 0;
        color: var(--color-muted);
        text-align: center;
        font-size: 0.85rem;
      }

      .footer-links {
        margin: 0 0 0.5rem;
      }

      a {
        color: var(--color-accent);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      h1, h2, h3, h4 {
        line-height: 1.4;
        margin: 2rem 0 1rem;
        font-weight: 700;
      }

      h1 { font-size: 1.75rem; }
      h2 { font-size: 1.4rem; }
      h3 { font-size: 1.15rem; }

      p {
        margin: 1rem 0;
      }

      img {
        max-width: 100%;
        height: auto;
      }

      code {
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        background-color: #f5f5f5;
        padding: 0.15em 0.35em;
        border-radius: 3px;
        font-size: 0.9em;
      }

      pre {
        background-color: #f5f5f5;
        padding: 1rem;
        border-radius: 4px;
        overflow-x: auto;
      }

      pre code {
        background: none;
        padding: 0;
      }

      blockquote {
        border-left: 3px solid var(--color-border);
        margin: 1.5rem 0;
        padding: 0.25rem 1rem;
        color: var(--color-muted);
      }

      hr {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 2rem 0;
      }

      @media (max-width: 480px) {
        body { font-size: 15px; }
        h1 { font-size: 1.5rem; }
        h2 { font-size: 1.25rem; }
        .site-title { font-size: 1rem; }
        .site-nav { gap: 1rem; }
      }
    </style>
  </body>
</html>
